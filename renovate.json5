{
    $schema: 'https://docs.renovatebot.com/renovate-schema.json',
    extends: [
        'config:recommended',
        'helpers:pinGitHubActionDigests',
        // Renovate には aqua manager が無いので、aqua-renovate-config の file preset で
        // .github/aqua.yaml の packages と registry を追う。preset はタグ付け替え対策で SHA pin し、
        // 下の customManager が末尾コメントの版を基に新しいタグの SHA へ更新する。
        // renovate: datasource=github-tags depName=aquaproj/aqua-renovate-config
        'github>aquaproj/aqua-renovate-config:file#6ce68f09aca25a88624f468d93fd38e2365e35e0(\\.github/(aqua-ci/)?aqua\\.ya?ml)', // 2.15.0
    ],
    timezone: 'Asia/Tokyo',
    // ruleset で全ブランチに署名を必須にするので、Renovate のコミットは GitHub に署名させる。
    platformCommit: 'enabled',
    // 冷却は GitHub Actions など、このリポジトリの CI で書き込み権限付きで動くものに効かせる。
    // versions.json の pin（php の追うタグ・親イメージ・FrankenPHP）は下のルールで外す
    // （このリポジトリのイメージの冷却は消費側で行う）。
    minimumReleaseAge: '3 days',
    platformAutomerge: true,
    // actions.lock を書き直す gh-actions-lock 拡張の版。ci.yml の GH_ACTIONS_LOCK_VERSION と揃える
    // （Renovate が CI より新しい版で lockfile を書くと、CI の --verify が未知の lockfile version で落ちる）。
    constraints: {
        // renovate: datasource=github-releases depName=github/gh-actions-lock
        ghActionsLock: 'v0.4.1',
    },
    customManagers: [
        {
            description: 'versions.json の php.<minor>: ビルドする版（パッチ付きの officialTag）と公式イメージの digest。夜のジョブが版だけを上げると digest は null になり、公式イメージの公開後に pinDigest で埋める。置き換えは versions.json の書式（scripts/lib/bump.mjs の formatVersions と同じ 2 スペースの JSON）を前提にする',
            customType: 'regex',
            managerFilePatterns: [
                '/^versions\\.json$/',
            ],
            matchStrings: [
                '"officialTag": "(?<currentValue>[^"]+)",\\s*"officialDigest": (?:"(?<currentDigest>sha256:[0-9a-f]{64})"|null)',
            ],
            depNameTemplate: 'php',
            datasourceTemplate: 'docker',
            autoReplaceStringTemplate: '"officialTag": "{{{newValue}}}",\n      "officialDigest": {{#if newDigest}}"{{{newDigest}}}"{{else}}null{{/if}}',
        },
        {
            description: 'versions.json の baseImages: 上流の Dockerfile がタグで参照する親イメージ（FROM・bake の docker-image コンテキスト・# syntax=）の digest',
            customType: 'regex',
            managerFilePatterns: [
                '/^versions\\.json$/',
            ],
            matchStrings: [
                '"(?<depName>[a-z0-9][a-z0-9._/-]*):(?<currentValue>[A-Za-z0-9._-]+)": "(?<currentDigest>sha256:[0-9a-f]{64})"',
            ],
            datasourceTemplate: 'docker',
        },
        {
            description: 'build.yml と ci.yml の setup-buildx-action に渡す BuildKit のイメージ（tag と digest）',
            customType: 'regex',
            managerFilePatterns: [
                '/^\\.github/workflows/(build|ci)\\.yml$/',
            ],
            matchStrings: [
                'image=(?<depName>moby/buildkit):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[0-9a-f]{64})',
            ],
            datasourceTemplate: 'docker',
        },
        {
            description: 'versions.json の frankenphp: 上流のタグと commit を二重に固定する。新しいタグが出ると版と commit を同時に更新する',
            customType: 'regex',
            managerFilePatterns: [
                '/^versions\\.json$/',
            ],
            matchStrings: [
                '"repository": "(?<depName>[^"]+)",\\s*"version": "(?<currentValue>[^"]+)",\\s*"commit": "(?<currentDigest>[0-9a-f]{40})"',
            ],
            datasourceTemplate: 'github-tags',
        },
        {
            description: 'extends の aqua-renovate-config preset を SHA pin のまま追う',
            customType: 'regex',
            managerFilePatterns: [
                '/^renovate\\.json5$/',
            ],
            matchStrings: [
                '// renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+\'github>[^#]+#(?<currentDigest>[0-9a-f]{40})[^\']*\',\\s*// (?<currentValue>\\S+)',
            ],
        },
        {
            description: 'gh-actions-lock 拡張の版を ci.yml の GH_ACTIONS_LOCK_VERSION と constraints.ghActionsLock の 2 か所で追う（同じ depName なので 1 つの PR にまとまる）',
            customType: 'regex',
            managerFilePatterns: [
                '/^\\.github/workflows/ci\\.yml$/',
                '/^renovate\\.json5$/',
            ],
            matchStrings: [
                '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+GH_ACTIONS_LOCK_VERSION: (?<currentValue>\\S+)',
                '// renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+ghActionsLock: \'(?<currentValue>[^\']+)\'',
            ],
        },
    ],
    packageRules: [
        {
            description: 'ビルドの入力（GitHub Actions、BuildKit、Node）の更新は週 1 回、1 つの PR にまとめる。マージのたびに build.yml が全版を作り直して公開し、消費側に digest 更新が届き、直列の run でセキュリティ更新も詰まるため。minor 以下と digest は自動マージ（PR の CI で動かない action は下の publish actions のグループで手動マージ）',
            matchManagers: [
                'github-actions',
                'nodenv',
            ],
            groupName: 'build inputs',
            schedule: [
                'before 10am on monday',
            ],
        },
        {
            matchPackageNames: [
                'moby/buildkit',
            ],
            groupName: 'build inputs',
            schedule: [
                'before 10am on monday',
            ],
        },
        {
            matchManagers: [
                'github-actions',
                'nodenv',
            ],
            matchUpdateTypes: [
                'minor',
                'patch',
                'digest',
                'pinDigest',
            ],
            automerge: true,
        },
        {
            matchPackageNames: [
                'moby/buildkit',
            ],
            matchUpdateTypes: [
                'minor',
                'patch',
                'digest',
            ],
            automerge: true,
        },
        {
            description: 'PR の CI では実行されず、公開権限や App の鍵を持つ main の run で初めて動く action は、build inputs のグループから分けて手動マージにする',
            matchManagers: [
                'github-actions',
            ],
            matchPackageNames: [
                'docker/login-action',
                'actions/upload-artifact',
                'actions/download-artifact',
                'actions/attest',
                'actions/create-github-app-token',
            ],
            groupName: 'publish actions',
            automerge: false,
        },
        {
            description: 'versions.json の docker イメージは、php のパッチ版の更新（8.6.0 → 8.6.1）と digest の更新だけを提案させる。minor 以上（php の 8.7）や親イメージのタグの更新（golang の 1.28 など）は提案させない。上流が親イメージのタグを変えたらビルドが止まるので、そのとき手で直す',
            matchFileNames: [
                'versions.json',
            ],
            matchDatasources: [
                'docker',
            ],
            matchUpdateTypes: [
                'major',
                'minor',
                'patch',
            ],
            enabled: false,
        },
        {
            matchFileNames: [
                'versions.json',
            ],
            matchDepNames: [
                'php',
            ],
            matchUpdateTypes: [
                'patch',
            ],
            enabled: true,
            // 既定の php-8.x だと複数の minor のパッチ更新が 1 つのブランチにまとまるので、minor ごとに分ける。
            branchTopic: '{{{depNameSanitized}}}-{{{newMajor}}}.{{{newMinor}}}.x',
        },
        {
            description: '夜のジョブが版だけを上げて digest が null の追うタグに、公式イメージの公開後に digest を入れる',
            matchFileNames: [
                'versions.json',
            ],
            matchDepNames: [
                'php',
            ],
            pinDigests: true,
        },
        {
            description: 'versions.json の php のパッチ版・digest の更新は即時・自動マージ（docker-library の更新や親イメージの更新を手放しで本番イメージへ届ける経路）。冷却は消費側で行う',
            matchFileNames: [
                'versions.json',
            ],
            matchDatasources: [
                'docker',
            ],
            matchUpdateTypes: [
                'patch',
                'digest',
                'pinDigest',
            ],
            minimumReleaseAge: null,
            schedule: [
                'at any time',
            ],
            automerge: true,
        },
        {
            description: 'FrankenPHP は即時に PR を作る。パッチには Caddy や Go のセキュリティ修正が入るので patch は自動マージ（PR の CI の smoke build が FrankenPHP を組む）、minor 以上は挙動の変化を含みうるので手動',
            matchDatasources: [
                'github-tags',
            ],
            matchPackageNames: [
                'php/frankenphp',
            ],
            minimumReleaseAge: null,
            schedule: [
                'at any time',
            ],
        },
        {
            matchDatasources: [
                'github-tags',
            ],
            matchPackageNames: [
                'php/frankenphp',
            ],
            matchUpdateTypes: [
                'patch',
            ],
            automerge: true,
        },
        {
            description: 'ランナーのラベル（runs-on の ubuntu-24.04 など）と .node-version のメジャー更新は提案させない。ランナーは versions.json の platforms にも書いてあり、片方だけ上がると食い違う。上げるときは両方を手で揃える',
            matchDatasources: [
                'github-runners',
                'node-version',
            ],
            matchUpdateTypes: [
                'major',
            ],
            enabled: false,
        },
        {
            description: 'aqua の版の更新は aqua-checksums.json の作り直し（`AQUA_CONFIG=<設定> aqua update-checksum --prune`）が要るので、1 つの PR にまとめて手動マージにする',
            matchFileNames: [
                '.github/aqua.yaml',
                '.github/aqua-ci/aqua.yaml',
            ],
            groupName: 'aqua',
            automerge: false,
        },
        {
            description: 'actions.lock を生成・検証する gh-actions-lock 拡張は手動マージ（lockfile の検証ツール自体を未レビューで入れ替えない）',
            matchPackageNames: [
                'github/gh-actions-lock',
            ],
            automerge: false,
        },
        {
            description: 'aqua-renovate-config preset は上の customManager で追うので、renovate-config manager 側の検出を無効にする',
            matchManagers: [
                'renovate-config',
            ],
            matchDepNames: [
                'aquaproj/aqua-renovate-config',
            ],
            enabled: false,
        },
    ],
}
